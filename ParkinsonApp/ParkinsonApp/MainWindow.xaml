<Window x:Class="ParkinsonApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParkinsonAppWindows.Controls"
        xmlns:vm="clr-namespace:ParkinsonAppWindows.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:models="clr-namespace:ParkinsonAppWindows.Models"
        mc:Ignorable="d"
        Title="Parkinson Analysis - Stage 1" Height="600" Width="900">

    <Window.DataContext>
        <vm:DetailViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <ObjectDataProvider x:Key="DrawingParams" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:DrawingParameter"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="10" BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="📂 Add Files" Command="{Binding LoadFileCommand}" Padding="10,5" Margin="0,0,20,0"/>
                <TextBlock Text="{Binding Session.FileName, StringFormat='File: {0}'}" VerticalAlignment="Center" FontWeight="Bold"/>

                <Separator Margin="20,0"/>
                <CheckBox Content="Dark Mode" IsChecked="{Binding IsDarkMode}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="20" BorderBrush="Gray" BorderThickness="1" Background="White">
            <local:DrawingCanvas 
                FullPoints="{Binding Session.DrawingPoints}"
                Limit="{Binding Session.CurrentPointIndex}"
                ThicknessParam="{Binding ThicknessParam}"
                ColorParam="{Binding ColorParam}"
                IsDarkMode="{Binding IsDarkMode}"/>
        </Border>

        <Border Grid.Row="2" Background="White" Padding="10" BorderBrush="#CCC" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <Button Content="⏯ Play/Pause" Command="{Binding PlayPauseCommand}" Padding="10,5" Margin="5"/>
                <Button Content="⏹ Reset" Command="{Binding ResetCommand}" Padding="10,5" Margin="5"/>

                <Separator Margin="20,0"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Thickness:" VerticalAlignment="Center" Margin="5"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource DrawingParams}}" 
                              SelectedItem="{Binding ThicknessParam}" Width="100"/>

                    <TextBlock Text="Color:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource DrawingParams}}" 
                              SelectedItem="{Binding ColorParam}" Width="100"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
