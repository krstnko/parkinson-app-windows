<Window x:Class="ParkinsonAppWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParkinsonAppWindows"
        xmlns:controls="clr-namespace:ParkinsonAppWindows.Controls"
        xmlns:vm="clr-namespace:ParkinsonAppWindows.ViewModels"
        xmlns:conv="clr-namespace:ParkinsonAppWindows.Converters"
        xmlns:models="clr-namespace:ParkinsonAppWindows.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Parkinson Analysis App" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>

        <ObjectDataProvider x:Key="DrawingParams" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:DrawingParameter"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Background="{Binding IsDarkMode, Converter={StaticResource ModeToColorConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="{Binding IsDarkMode, Converter={StaticResource ModeToToolbarColorConverter}}" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10">

            <StackPanel Orientation="Horizontal">

                <Button Command="{Binding LoadFilesCommand}" Padding="10,5" Margin="0,0,5,0" 
                        Background="Transparent" BorderBrush="Gray" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📂 Add Files" 
                                   Foreground="{Binding IsDarkMode, Converter={StaticResource ModeToTextColorConverter}}"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ClearCommand}" Padding="10,5" Margin="0,0,15,0" 
                        Background="Transparent" BorderBrush="Gray" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ClearButtonText}" 
                            Foreground="{Binding IsDarkMode, Converter={StaticResource ModeToTextColorConverter}}" Cursor="No"/>
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Fill="Gray" Margin="0,5,15,5"/>

                <CheckBox Content="Dark Mode" IsChecked="{Binding IsDarkMode}" 
                          Foreground="{Binding IsDarkMode, Converter={StaticResource ModeToTextColorConverter}}"
                          VerticalAlignment="Center" Margin="0,0,15,0"/>

                <Rectangle Width="1" Fill="Gray" Margin="0,5,15,5"/>

                <Button Command="{Binding ResetCommand}" Padding="10,5" Margin="0,0,5,0" Background="Transparent">
                    <TextBlock Text="⏮ Reset" Foreground="{Binding IsDarkMode, Converter={StaticResource ModeToTextColorConverter}}"/>
                </Button>

                <Button Command="{Binding PlayPauseCommand}" Padding="10,5" MinWidth="80" Margin="0,0,15,0" Background="Transparent">
                    <TextBlock Text="{Binding IsPlaying, Converter={StaticResource BoolToPlayPauseConverter}}" 
                               Foreground="{Binding IsDarkMode, Converter={StaticResource ModeToTextColorConverter}}"/>
                </Button>

                <Button Command="{Binding OpenExportCommand}" Padding="10,5" Margin="0,0,15,0" 
                        Background="Transparent" BorderBrush="Gray" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📤 Export" 
                   Foreground="{Binding IsDarkMode, Converter={StaticResource ModeToTextColorConverter}}"/>
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Fill="Gray" Margin="0,5,15,5"/>

                <Rectangle Width="1" Fill="Gray" Margin="0,5,15,5"/>

                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Thickness" FontSize="10" Foreground="Gray"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource DrawingParams}}" 
                              SelectedItem="{Binding ThicknessParam}" Width="120"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Color" FontSize="10" Foreground="Gray"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource DrawingParams}}" 
                              SelectedItem="{Binding ColorParam}" Width="120"/>
                </StackPanel>

                <ProgressBar IsIndeterminate="True" Width="100" Height="15" Margin="20,0,0,0" 
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <TextBlock Text="{Binding Sessions.Count, StringFormat='{}{0} files'}" 
                           VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="10">
            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="350" Height="300" Margin="10" CornerRadius="8" Effect="{StaticResource CardShadow}"
            BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{Binding DataContext.IsDarkMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ModeToToolbarColorConverter}}"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="#3399FF"/>
                                            <Setter Property="Background" Value="#113399FF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" 
                          Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                          CommandParameter="{Binding}"/>
                            </Border.InputBindings>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Padding="10" CornerRadius="8,8,0,0">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{Binding DataContext.IsDarkMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ModeToTextColorConverter}}"/>
                                    </Border>

                                    <CheckBox Grid.Column="1" 
                          IsChecked="{Binding IsSelected}" 
                          VerticalAlignment="Center" 
                          Margin="0,0,10,0">
                                        <CheckBox.LayoutTransform>
                                            <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                                        </CheckBox.LayoutTransform>
                                    </CheckBox>
                                </Grid>

                                <Border Grid.Row="1" ClipToBounds="True" Margin="5">
                                    <controls:DrawingCanvas IsHitTestVisible="False"
                    FullPoints="{Binding DrawingPoints}"
                    Limit="{Binding CurrentIndex}"
                    ThicknessParam="{Binding DataContext.ThicknessParam, RelativeSource={RelativeSource AncestorType=Window}}"
                    ColorParam="{Binding DataContext.ColorParam, RelativeSource={RelativeSource AncestorType=Window}}"
                    IsDarkMode="{Binding DataContext.IsDarkMode, RelativeSource={RelativeSource AncestorType=Window}}"
                />
                                </Border>

                                <Border Grid.Row="2" Padding="8" CornerRadius="0,0,8,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Stats.MinP, StringFormat='P: {0:F2}'}" FontSize="10" Foreground="Gray"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Stats.MinA, StringFormat='A: {0:F2}'}" FontSize="10" Foreground="Gray"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Stats.MinL, StringFormat='L: {0:F2}'}" FontSize="10" Foreground="Gray"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>