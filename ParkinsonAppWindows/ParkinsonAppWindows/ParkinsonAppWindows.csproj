<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="ModelsONNX\filter_DT.onnx" />
    <None Remove="ModelsONNX\filter_KNN.onnx" />
    <None Remove="ModelsONNX\filter_LR.onnx" />
    <None Remove="ModelsONNX\filter_RF.onnx" />
    <None Remove="ModelsONNX\filter_SVM.onnx" />
    <None Remove="ModelsONNX\wrapper_DT.onnx" />
    <None Remove="ModelsONNX\wrapper_KNN.onnx" />
    <None Remove="ModelsONNX\wrapper_LR.onnx" />
    <None Remove="ModelsONNX\wrapper_RF.onnx" />
    <None Remove="ModelsONNX\wrapper_SVM.onnx" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ModelsONNX\filter_DT.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ModelsONNX\filter_KNN.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ModelsONNX\filter_LR.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ModelsONNX\filter_RF.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ModelsONNX\filter_SVM.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ModelsONNX\wrapper_DT.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ModelsONNX\wrapper_KNN.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="ModelsONNX\wrapper_LR.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ModelsONNX\wrapper_RF.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ModelsONNX\wrapper_SVM.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
  </ItemGroup>

</Project>
