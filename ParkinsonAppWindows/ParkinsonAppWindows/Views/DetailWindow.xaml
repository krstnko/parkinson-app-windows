<Window x:Class="ParkinsonAppWindows.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParkinsonAppWindows.Controls"
        xmlns:vm="clr-namespace:ParkinsonAppWindows.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:DetailViewModel}"
        Title="{Binding Session.FileName}" Height="750" Width="1000">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Background" Value="White"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                        <Setter Property="Background" Value="#1E1E1E"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid Grid.Column="0" ClipToBounds="True">

            <Grid Background="Transparent"
                  MouseWheel="OnMouseWheel"
                  MouseLeftButtonDown="OnMouseDown"
                  MouseLeftButtonUp="OnMouseUp"
                  MouseMove="OnMouseMove">

                <local:DrawingCanvas x:Name="DetailCanvas"
                                     FullPoints="{Binding Session.DrawingPoints}"
                                     Limit="{Binding Session.CurrentIndex}"
                                     ThicknessParam="{Binding ThicknessParam}"
                                     ColorParam="{Binding ColorParam}"
                                     IsDarkMode="{Binding IsDarkMode}"
                                     ShowGrid="{Binding ShowGrid, FallbackValue=True}">
                    <local:DrawingCanvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                            <TranslateTransform X="{Binding OffsetX}" Y="{Binding OffsetY}"/>
                        </TransformGroup>
                    </local:DrawingCanvas.RenderTransform>
                </local:DrawingCanvas>
            </Grid>

            <local:LegendControl HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20"/>

            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Background="{Binding IsDarkMode, Converter={StaticResource BooleanToBrushConverter}, FallbackValue='#CCF0F0F0'}"
                    CornerRadius="10" Padding="15" Margin="0,0,0,20"
                    BorderBrush="Gray" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="Thickness:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox ItemsSource="{Binding AvailableParameters}"
                                  SelectedItem="{Binding ThicknessParam}" Width="100" Margin="0,0,15,0"/>

                        <TextBlock Text="Color:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox ItemsSource="{Binding AvailableParameters}"
                                  SelectedItem="{Binding ColorParam}" Width="100" Margin="0,0,15,0"/>

                        <CheckBox Content="Dark Mode" IsChecked="{Binding IsDarkMode}" VerticalAlignment="Center" Margin="0,0,15,0"/>

                        <Button Command="{Binding ToggleSidebarCommand}" Content="Sidebar" Padding="5,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="{Binding IsPlaying, Converter={StaticResource PlayPauseTextConverter}, FallbackValue='Play/Pause'}" 
                                Command="{Binding PlayPauseCommand}" FontWeight="Bold" MinWidth="80"/>
                        <Button Content="Reset" Command="{Binding ResetAnimationCommand}"/>
                        <Rectangle Width="1" Fill="Gray" Margin="10,2"/>
                        <Button Content="Reset Zoom" Command="{Binding ResetZoomCommand}"/>
                        <TextBlock Text="{Binding Scale, StringFormat='Zoom: {0:F1}x'}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Column="1" Width="300" BorderBrush="Gray" BorderThickness="1,0,0,0"
                Background="{Binding IsDarkMode, Converter={StaticResource BooleanToBrushConverter}, FallbackValue='#F9F9F9'}"
                Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVis}}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Padding="15" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Predictor" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1">
                    <Button Content="Run Analysis" Command="{Binding RunAnalysisCommand}" 
                            Height="30" Background="#007AFF" Foreground="White" FontWeight="Bold"
                            IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" 
                               Margin="0,5,0,0" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisConverter}}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2" Padding="15">
                    <StackPanel>
                        <Border Visibility="{Binding EnsembleDiagnosis, Converter={StaticResource StringToVisConverter}}"
                                Background="{Binding EnsembleColor, Converter={StaticResource BrushToTranslucentConverter}}"
                                BorderBrush="{Binding EnsembleColor}" 
                                BorderThickness="1"
                                CornerRadius="10" 
                                Padding="20" 
                                Margin="0,0,0,20">
                            <StackPanel HorizontalAlignment="Center">

                                <TextBlock Text="Average Parkinson Probability" 
                                           Foreground="{Binding IsDarkMode, Converter={StaticResource ModeToTextColorConverter}, FallbackValue='#555'}"
                                           Opacity="0.8"
                                           FontSize="12" 
                                           HorizontalAlignment="Center" 
                                           Margin="0,0,0,5"/>

                                <TextBlock FontSize="36" FontWeight="ExtraBold" HorizontalAlignment="Center"
                                           Foreground="{Binding EnsembleColor}">
                                    <Run Text="{Binding EnsembleProbability, StringFormat={}{0:F1}}"/><Run Text="%"/>
                                </TextBlock>

                                <TextBlock Text="{Binding EnsembleDiagnosis}" 
                                           Foreground="{Binding EnsembleColor}" 
                                           FontSize="16" FontWeight="SemiBold" 
                                           HorizontalAlignment="Center" 
                                           Margin="0,5,0,0"/>

                                <Button Content="Clear Result" Command="{Binding ClearAnalysisCommand}" 
                                        FontSize="11" Margin="0,15,0,0" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0" Foreground="Gray">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Model Results" FontWeight="Bold" Margin="0,0,0,10" 
                                   Visibility="{Binding AnalysisResults, Converter={StaticResource CollectionToVisConverter}}"/>

                        <ItemsControl ItemsSource="{Binding AnalysisResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <Grid>
                                            <TextBlock Text="{Binding ModelName}" FontSize="12" HorizontalAlignment="Left" Foreground="#333"/>
                                            <TextBlock FontSize="12" FontWeight="Bold" HorizontalAlignment="Right">
                                                 <Run Text="{Binding Probability, StringFormat=F0}"/><Run Text="%"/>
                                            </TextBlock>
                                        </Grid>
                                        <Grid Height="8" Margin="0,4,0,0">
                                            <Border Background="#E5E5E5" CornerRadius="4"/>
                                            <Border HorizontalAlignment="Left" Background="{Binding Color}" CornerRadius="4"
                                                    Width="{Binding Probability, Converter={StaticResource ProbToWidthConverter}, ConverterParameter=260}"/>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>