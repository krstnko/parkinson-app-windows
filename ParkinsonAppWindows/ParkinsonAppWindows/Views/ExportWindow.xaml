<Window x:Class="ParkinsonAppWindows.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParkinsonAppWindows.Controls"
        xmlns:vm="clr-namespace:ParkinsonAppWindows.ViewModels"
        xmlns:models="clr-namespace:ParkinsonAppWindows.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:conv="clr-namespace:ParkinsonAppWindows.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ExportViewModel}"
        Title="Export &amp; Analysis Dashboard" Height="900" Width="1250"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DropShadowEffect x:Key="PaperShadow" BlurRadius="15" ShadowDepth="4" Direction="270" Opacity="0.2"/>

        <ObjectDataProvider x:Key="DrawingParams" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:DrawingParameter"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#2D3436"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F3F3F3">

        <TabControl Margin="10" BorderThickness="0" Background="Transparent">

            <TabItem Header="Export Series (Grid)" FontSize="14" Padding="10,5">
                <Grid Background="#F3F3F3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="5" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,10,0" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Export Configuration" FontWeight="Bold" FontSize="20" Margin="0,0,0,15" Foreground="#333"/>
                                <GroupBox Header="Global Settings" Margin="0,0,0,15" Padding="10">
                                    <StackPanel>
                                        <CheckBox Content="Dark Mode (Inverted Colors)" IsChecked="{Binding IsDarkMode}" Margin="0,0,0,10"/>
                                        <CheckBox Content="Show Grid Lines &amp; Axes" IsChecked="{Binding ShowGrid}" Margin="0,0,0,0"/>
                                    </StackPanel>
                                </GroupBox>
                                <TextBlock Text="Graphs List:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#555"/>
                            </StackPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding ExportItems}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="1" BorderBrush="#EEE" Background="#FAFAFA" Margin="0,5">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#DDD" BorderThickness="1" Padding="10" Margin="0,2" CornerRadius="4" Background="White">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📄" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding Session.FileName}" FontWeight="Bold" Foreground="#333" TextTrimming="CharacterEllipsis" MaxWidth="180" ToolTip="{Binding Session.FileName}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Command="{Binding DataContext.RemoveViewCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Width="24" Height="24" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                        <TextBlock Text="✕" Foreground="Red" FontWeight="Bold"/>
                                                    </Button>
                                                </Grid>
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Width" FontSize="10" Foreground="Gray"/>
                                                        <ComboBox ItemsSource="{Binding Source={StaticResource DrawingParams}}" SelectedItem="{Binding ThicknessParam}" Height="25" FontSize="11"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Color" FontSize="10" Foreground="Gray"/>
                                                        <ComboBox ItemsSource="{Binding Source={StaticResource DrawingParams}}" SelectedItem="{Binding ColorParam}" Height="25" FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Margin="0,15,0,0">
                                <Button Content="+ Add Graph" Command="{Binding AddViewCommand}" Height="35" Margin="0,0,0,10" Background="White" BorderBrush="#CCC"/>
                                <Button Content="💾 EXPORT TO FILE" Command="{Binding ExportAllCommand}" CommandParameter="{Binding ElementName=PreviewContainer}" Height="50" FontWeight="Bold" FontSize="14" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand">
                                    <Button.Effect>
                                        <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.2"/>
                                    </Button.Effect>
                                </Button>
                                <TextBlock Text="* Exports all items as a grid layout (SVG/PDF)" FontSize="10" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="#E5E5E5" CornerRadius="5" ClipToBounds="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Preview (A4 Layout Approximation)" FontWeight="Bold" Foreground="#777" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                <Border x:Name="PreviewContainer" Background="White" Effect="{StaticResource PaperShadow}" Width="700" MinHeight="800" HorizontalAlignment="Center" VerticalAlignment="Top" BorderBrush="#CCC" BorderThickness="1">
                                    <ItemsControl ItemsSource="{Binding ExportItems}" Padding="20">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="340" Padding="10">
                                                    <Grid>
                                                        <local:DrawingCanvas FullPoints="{Binding Session.DrawingPoints}" Limit="{Binding Session.DrawingPoints.Count}" ThicknessParam="{Binding ThicknessParam}" ColorParam="{Binding ColorParam}" IsDarkMode="{Binding DataContext.IsDarkMode, RelativeSource={RelativeSource AncestorType=Window}}" ShowGrid="{Binding DataContext.ShowGrid, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <TextBlock Text="{Binding Session.FileName}" VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="11" Foreground="Gray" Margin="0,0,0,-5" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Model Analysis" FontSize="14" Padding="10,5">
                <Grid Background="#F3F3F3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="5" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,10,0" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Analysis Settings" FontWeight="Bold" FontSize="18" Margin="0,0,0,15" Foreground="#333"/>

                            <GroupBox Grid.Row="1" Header="Drawing Visualization" Margin="0,0,0,15" Padding="5">
                                <StackPanel>
                                    <TextBlock Text="Line Thickness:" FontSize="12" Foreground="Gray" Margin="0,5,0,2"/>
                                    <ComboBox ItemsSource="{Binding Source={StaticResource DrawingParams}}" 
                                              SelectedItem="{Binding SingleThicknessParam}" 
                                              Height="30" VerticalContentAlignment="Center"/>

                                    <TextBlock Text="Line Color:" FontSize="12" Foreground="Gray" Margin="0,10,0,2"/>
                                    <ComboBox ItemsSource="{Binding Source={StaticResource DrawingParams}}" 
                                              SelectedItem="{Binding SingleColorParam}" 
                                              Height="30" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </GroupBox>

                            <TextBlock Grid.Row="2" Text="Select Models:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ListBox Grid.Row="2" ItemsSource="{Binding AnalysisModels}" BorderThickness="1" BorderBrush="#EEE" Background="#FAFAFA" Margin="0,0,0,15">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="5" VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button Grid.Row="3" Content="▶ RUN ANALYSIS" Command="{Binding CalculateCommand}" 
                                    Height="45" Margin="0,0,0,20" Background="#6C5CE7" Foreground="White" 
                                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" FontSize="14">
                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.2"/>
                                </Button.Effect>
                            </Button>

                            <StackPanel Grid.Row="4">
                                <Separator Margin="0,0,0,15"/>
                                <TextBlock Text="Export Report" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="AnalysisFormatCombo" SelectedIndex="0" Margin="0,0,0,10" Padding="5" Height="30">
                                    <ComboBoxItem Content="PNG"/>
                                    <ComboBoxItem Content="JPEG"/>
                                    <ComboBoxItem Content="PDF"/>
                                </ComboBox>
                                <Button Content="💾 SAVE REPORT IMAGE" Click="OnExportAnalysisClick" 
                                        Height="40" Background="#00B894" Foreground="White" FontWeight="Bold" 
                                        BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="#E5E5E5" CornerRadius="5" ClipToBounds="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="20">

                                <Border x:Name="CaptureGrid" Background="White" Effect="{StaticResource PaperShadow}" 
                                        BorderBrush="#CCC" BorderThickness="1" Padding="30" Width="800" HorizontalAlignment="Center">
                                    <StackPanel>

                                        <Border BorderBrush="#EEE" BorderThickness="0,0,0,2" Padding="0,0,0,20" Margin="0,0,0,20">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Session.FileName}" FontSize="28" FontWeight="Bold" 
                                                           Foreground="#2D3436" HorizontalAlignment="Center" TextWrapping="Wrap"/>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                                    <TextBlock Text="Mode: " FontWeight="Bold" Foreground="Gray"/>
                                                    <TextBlock Text="Thickness: " Foreground="#555"/>
                                                    <TextBlock Text="{Binding SingleThicknessParam}" FontWeight="SemiBold" Foreground="#333" Margin="0,0,10,0"/>

                                                    <TextBlock Text="Color: " Foreground="#555"/>
                                                    <TextBlock Text="{Binding SingleColorParam}" FontWeight="SemiBold" Foreground="#333"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Viewbox Height="400" Margin="0,0,0,20">
                                            <local:DrawingCanvas 
                                                Width="800" Height="600"
                                                FullPoints="{Binding Session.DrawingPoints}"
                                                Limit="{Binding Session.DrawingPoints.Count}" 
                                                ThicknessParam="{Binding SingleThicknessParam}" 
                                                ColorParam="{Binding SingleColorParam}"
                                                IsDarkMode="False"
                                                ShowGrid="True"/>
                                        </Viewbox>

                                        <Border Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,30">
                                            <UniformGrid Columns="4">
                                                <StackPanel>
                                                    <TextBlock Text="DURATION" Style="{StaticResource StatLabel}"/>
                                                    <TextBlock Text="{Binding StatDuration}" Style="{StaticResource StatValue}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="AVG PRESSURE" Style="{StaticResource StatLabel}"/>
                                                    <TextBlock Text="{Binding StatPressure}" Style="{StaticResource StatValue}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="AVG AZIMUTH" Style="{StaticResource StatLabel}"/>
                                                    <TextBlock Text="{Binding StatAzimuth}" Style="{StaticResource StatValue}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="AVG ALTITUDE" Style="{StaticResource StatLabel}"/>
                                                    <TextBlock Text="{Binding StatAltitude}" Style="{StaticResource StatValue}"/>
                                                </StackPanel>
                                            </UniformGrid>
                                        </Border>

                                        <TextBlock Text="AI Predictions:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="#333"/>

                                        <ItemsControl ItemsSource="{Binding AnalysisModels}" Margin="0,0,0,30">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4" Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="220"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="70"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#636E72" VerticalAlignment="Center" FontSize="13"/>
                                                        <ProgressBar Grid.Column="1" Value="{Binding Probability}" Maximum="100" Height="8" Margin="10,0" BorderBrush="#DDD" Background="#EEE" Foreground="#FF7675"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Probability, StringFormat={}{0:F1}%}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#2D3436"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Background="#F0F0F0" BorderThickness="0,2,0,0" BorderBrush="#DDD" Padding="20">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="AGGREGATED PROBABILITY" FontWeight="Bold" Foreground="#B2BEC3" FontSize="12" HorizontalAlignment="Center"/>

                                                <TextBlock Text="{Binding FinalAvg}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,15" Foreground="#2D3436"/>

                                                <Border Background="{Binding DiagnosisColor}" CornerRadius="6" Padding="40,15">
                                                    <StackPanel>
                                                        <TextBlock Text="ESTIMATED STATUS:" Foreground="White" Opacity="0.8" HorizontalAlignment="Center" FontSize="10"/>
                                                        <TextBlock Text="{Binding FinalDiagnosis}" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>