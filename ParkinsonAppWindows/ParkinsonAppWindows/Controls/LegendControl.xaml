<UserControl x:Class="ParkinsonAppWindows.Controls.LegendControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ParkinsonAppWindows.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DetailViewModel}"
             Width="300">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ExpandButtonStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <TextBlock x:Name="Arrow" Text="▼" FontSize="14" Foreground="Gray" HorizontalAlignment="Right"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Arrow" Property="Text" Value="◀"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LegendBackgroundStyle" TargetType="Border">
            <Setter Property="Background" Value="#F2F2F2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                    <Setter Property="Background" Value="#262626"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border
            CornerRadius="8" Padding="16" BorderBrush="Gray" BorderThickness="0.5">
        <StackPanel>

            <Grid Margin="0,0,0,4">
                <TextBlock Text="Visualization Key" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"
                           Foreground="{Binding PrimaryColorBrush}"/>
                <ToggleButton x:Name="ExpandToggle" 
                              Style="{StaticResource ExpandButtonStyle}"
                              IsChecked="True"
                              HorizontalAlignment="Right" 
                              Cursor="Hand"
                              Click="OnToggleClick"/>
            </Grid>

            <StackPanel x:Name="ContentPanel" Visibility="Visible">
                <Separator Margin="0,4,0,16"/>

                <StackPanel Visibility="{Binding IsThicknessNone, Converter={StaticResource InverseBoolToVisConverter}}">
                    <TextBlock Text="{Binding ThicknessParam, StringFormat='Thickness: {0}'}" 
                               FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"
                               Foreground="{Binding PrimaryColorBrush}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" HorizontalAlignment="Left">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                            <Rectangle Width="40" Height="2" Fill="{Binding PrimaryColorBrush}" RadiusX="1" RadiusY="1"/>
                            <TextBlock Text="Min Value" FontSize="10" Foreground="Gray" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,15,15" Foreground="Gray"/>

                        <StackPanel VerticalAlignment="Center">
                            <Rectangle Width="40" Height="8" Fill="{Binding PrimaryColorBrush}" RadiusX="2" RadiusY="2"/>
                            <TextBlock Text="Max Value" FontSize="10" Foreground="Gray" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding ThicknessDescription}" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <Separator Margin="0,0,0,16"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsColorNone, Converter={StaticResource InverseBoolToVisConverter}}">
                    <TextBlock Text="{Binding ColorParam, StringFormat='Color: {0}'}" 
                               FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"
                               Foreground="{Binding PrimaryColorBrush}"/>

                    <Grid Height="16" Margin="0,0,0,4">
                        <Border CornerRadius="4" BorderBrush="#4D808080" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding ColorParam}" Value="Pressure">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00E600" Offset="0.0"/>
                                                        <GradientStop Color="#E60000" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ColorParam}" Value="Altitude">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#800080" Offset="0.0"/>
                                                        <GradientStop Color="#FF0080" Offset="0.5"/>
                                                        <GradientStop Color="#FF9900" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ColorParam}" Value="Azimuth">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#FF0000" Offset="0.0"/>
                                                        <GradientStop Color="#CCFF00" Offset="0.2"/>
                                                        <GradientStop Color="#00FF66" Offset="0.4"/>
                                                        <GradientStop Color="#00FFFF" Offset="0.5"/>
                                                        <GradientStop Color="#0066FF" Offset="0.6"/>
                                                        <GradientStop Color="#CC00FF" Offset="0.8"/>
                                                        <GradientStop Color="#FF0000" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid x:Name="StandardLabels" Visibility="Visible">
                            <TextBlock Text="Min" FontSize="10" Foreground="Gray" HorizontalAlignment="Left"/>
                            <TextBlock Text="Max" FontSize="10" Foreground="Gray" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid x:Name="AzimuthLabels" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="←" FontSize="10" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Left" ToolTip="Left"/>
                            <TextBlock Grid.Column="1" Text="↑" FontSize="10" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center" ToolTip="Up"/>
                            <TextBlock Grid.Column="2" Text="→" FontSize="10" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center" ToolTip="Right"/>
                            <TextBlock Grid.Column="3" Text="↓" FontSize="10" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Center" ToolTip="Down"/>
                            <TextBlock Grid.Column="4" Text="←" FontSize="10" FontWeight="Bold" Foreground="Gray" HorizontalAlignment="Right" ToolTip="Left"/>
                        </Grid>
                    </Grid>

                    <TextBlock Text="{Binding ColorDescription}" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource LegendBackgroundStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ColorParam}" Value="Azimuth">
                        <Setter Property="Tag" Value="Azimuth"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    </Border>
</UserControl>